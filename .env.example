# Zaffran Store Environment Configuration
# Local XAMPP Environment

APP_NAME="Zaffran"
APP_TAGLINE="Pure Botanicals, Artisanal Fragrances & Essence Oils"
APP_ENV="development"
APP_DEBUG="true"
APP_URL="http://localhost/zaffran"

# Application Key for Cryptographic OTP Binding (Keep secret in production)
APP_KEY="base64_zaffran_secure_botanical_app_key_2026_x89a"

# Database Configuration (XAMPP Default)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="zaffran_db"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# Session Settings
SESSION_LIFETIME="86400"
SESSION_NAME="zaffran_session"

# Business & Inquiry Contacts (Supplier contact only, not for checkout bypass)
STORE_PHONE="0304-1202111"
STORE_WHATSAPP="923041202111"
STORE_EMAIL="info@zaffran.local"
STORE_CITY="Kot Addu, Punjab, Pakistan"

# Real SMTP Email Configuration
# Mode options:
# - 'smtp': connects to configured live SMTP server using secure TLS socket
# - 'test': records email to logs/emails/ directory for safe local testing without sending real customer emails
MAIL_DRIVER="test"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL="concierge@zaffran.local"
SMTP_FROM_NAME="Zaffran Concierge"
